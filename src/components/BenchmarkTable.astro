---
// The frame of a benchmark table: title, caption, a sideways-scrolling table, and a note under it.
// The table itself comes in the default slot, from CapacityTable or LevelTable.
interface Props {
  title: string;
  caption: string;
  note?: string;
  /** For tables with many columns: they start scrolling sideways at a wider width. */
  wide?: boolean;
  class?: string;
}

const { title, caption, note, wide = false, class: className } = Astro.props;
---

<div class:list={['bench', { 'bench--wide': wide }, className]}>
  <div class="bench__head">
    <h3>{title}</h3>
    <p class="eyebrow">{caption}</p>
  </div>
  <div class="bench__scroll">
    <slot />
  </div>
  {note && <p class="bench__note">{note}</p>}
</div>

<style lang="scss">
  .bench__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-bottom: var(--s-4);

    .eyebrow {
      margin-top: 0;
    }
  }

  .bench__scroll {
    overflow-x: auto;
    border-top: 1px solid var(--rule-strong);
  }

  // The table comes from the slot, so its styles reach it from here.
  .bench {
    :global(table) {
      width: 100%;
      min-width: var(--table-min);
      font-size: var(--t-small);
    }

    :global(th),
    :global(td) {
      padding: var(--s-3) var(--s-4);
      border-bottom: 1px solid var(--rule);
      text-align: right;
      color: var(--fg2);
    }

    :global(thead th) {
      vertical-align: bottom;
      font-family: var(--font-mono);
      font-size: var(--t-micro);
      font-weight: var(--weight-medium);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    // A header over several columns, such as a machine over its figures.
    :global(thead th[scope='colgroup']) {
      text-align: center;
      color: var(--fg1);
    }

    :global(td) {
      font-family: var(--font-mono);
      font-size: var(--t-caption);
      white-space: nowrap;
    }

    // A server's name, and the headers over such names, read as text, left aligned.
    :global(.start),
    :global(th[scope='row']) {
      text-align: left;
    }

    :global(th[scope='row']) {
      font-family: var(--font-body);
      font-size: var(--t-body-sm);
      font-weight: var(--weight-regular);
    }

    :global(th[scope='rowgroup']) {
      vertical-align: top;
      text-align: left;
      font-family: var(--font-display);
      font-size: var(--t-h3);
      font-weight: var(--weight-regular);
      line-height: var(--lh-display);
      letter-spacing: var(--tracking-heading);
      color: var(--fg1);
    }

    :global(th[scope='rowgroup'] small) {
      display: block;
      margin-top: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--t-micro);
      letter-spacing: normal;
      color: var(--fg2);
    }

    :global(tbody tr:last-child > *),
    :global(th[scope='rowgroup']) {
      border-bottom-color: var(--rule-strong);
    }

    :global(.is-iq > *) {
      background: var(--paper-soft);
      font-weight: var(--weight-medium);
      color: var(--fg1);
    }

    :global(.is-iq th[scope='row']) {
      font-weight: var(--weight-semibold);
    }
  }

  .bench--wide :global(table) {
    min-width: calc(var(--table-min) * 1.3);
  }

  .bench__note {
    max-width: var(--measure-text);
    margin-top: var(--s-4);
    font-size: var(--t-caption);
  }
</style>
