---
// The plans, on grey: the free app, Hobby, Team and Business, and a custom plan. Each is one app's.
import Button from '../Button.astro';
import Grid from '../Grid.astro';
import Section from '../Section.astro';
import PriceCard from './PriceCard.astro';
import { CONTACT, GET_STARTED } from '../../consts/site';
import { EXTRA_GB_CENTS, EXTRA_STREAM_CENTS, FREE_APP, PLANS } from '../../consts/pricing';
import { formatGigabytes, formatMinutes, formatNumber, formatUnitPrice } from '../../utils/format';

const free = `${formatNumber(FREE_APP.maxStreams)} concurrent streams of up to ${formatMinutes(FREE_APP.streamMinutes)} and ${FREE_APP.streamMiB} MiB, ${formatGigabytes(FREE_APP.egressGb)} of egress a month, ${FREE_APP.subscribersPerStream} subscribers per stream and ${FREE_APP.eventKiB} KiB events.`;
---

<Section id="plans" tone="soft" eyebrow="Plans">
  <Fragment slot="title">A plan for each app, <em>monthly</em>.</Fragment>
  <Fragment slot="aside">
    <p>
      Each app has a plan of its own, so one can run on Hobby and another on Business. Pick the plan whose maximum fits
      your busiest minute: its price prepays streams and egress, and usage covers the rest.
    </p>
    <p>
      Above the prepaid ones, every plan bills {formatUnitPrice(EXTRA_STREAM_CENTS)} for each extra concurrent stream at
      the month’s peak, and {formatUnitPrice(EXTRA_GB_CENTS)} per GB. Prices are per app, in EUR, before VAT.
    </p>
  </Fragment>

  <div class="plans">
    <div class="bar">
      <div>
        <p class="eyebrow">Free</p>
        <p class="bar__text"><strong>One app on your personal team, never billed:</strong> {free}</p>
      </div>
      <Button href={GET_STARTED.href} variant="primary">{GET_STARTED.label}</Button>
    </div>

    <Grid min="md">
      {PLANS.map((plan) => <PriceCard plan={plan} />)}
    </Grid>

    <div class="bar">
      <div>
        <p class="eyebrow">Custom</p>
        <p class="bar__text">
          <strong>For teams shipping agents at scale.</strong> More concurrent streams, longer streams and terms of your
          own.
        </p>
      </div>
      <Button href={CONTACT.href} variant="dark">{CONTACT.label}</Button>
    </div>
  </div>
</Section>

<style lang="scss">
  .plans {
    display: grid;
    gap: var(--s-6);
  }

  // The free app and the custom plan: one line each, above and below the paid plans.
  .bar {
    display: grid;
    gap: var(--s-4) var(--s-7);
    padding-block: var(--s-5);
    border-block: 1px solid var(--rule-strong);

    @include up(md) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  .bar__text {
    margin-top: var(--s-2);
  }
</style>
