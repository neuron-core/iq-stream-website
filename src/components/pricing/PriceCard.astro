---
// One paid plan: the ceiling it unlocks, its monthly price per app, what that prepays, and every limit.
import Button from '../Button.astro';
import Panel from '../Panel.astro';
import { GET_STARTED } from '../../consts/site';
import { prepaidSaving, prepaidStreamCents, type Plan } from '../../consts/pricing';
import { formatCents, formatGigabytes, formatMinutes, formatNumber, formatUnitPrice } from '../../utils/format';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;

const prepaid = [
  { value: formatNumber(plan.prepaidStreams), text: 'concurrent streams' },
  { value: formatGigabytes(plan.prepaidEgressGb), text: 'of egress' },
];

// The most streams at once is the card's eyebrow, the number a plan is picked by.
const limits = [
  { value: formatNumber(plan.subscribersPerStream), text: 'subscribers per stream' },
  { value: `${plan.eventKiB} KiB`, text: 'per event' },
  { value: formatMinutes(plan.streamMinutes), text: 'per stream' },
  { value: `${plan.streamMiB} MiB`, text: 'per stream' },
  { value: 'Private link', text: 'to your VPC' },
  { value: 'No cap', text: 'on messages' },
];
---

<Panel as="article" class="card">
  <p class="eyebrow">Up to {formatNumber(plan.maxStreams)} streams at once</p>
  <h3>{plan.name}</h3>
  <p class="card__amount">
    <span class="card__figure">{formatCents(plan.cents)}</span>
    <span class="card__per">a month, per app</span>
  </p>

  <div class="card__group">
    <p class="label">Includes every month</p>
    <ul class="card__list">
      {
        prepaid.map(({ value, text }) => (
          <li>
            <strong>{value}</strong> {text}
          </li>
        ))
      }
    </ul>
    <p class="card__note">
      A prepaid stream costs {formatUnitPrice(prepaidStreamCents(plan))}, {prepaidSaving(plan)}% less than an extra one.
    </p>
  </div>

  <div class="card__group">
    <p class="label">Limits</p>
    <ul class="card__list">
      {
        limits.map(({ value, text }) => (
          <li>
            <strong>{value}</strong> {text}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="card__foot">
    <Button href={GET_STARTED.href} variant="outline">Choose {plan.name}</Button>
  </div>
</Panel>

<style lang="scss">
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__amount {
    margin-top: var(--s-5);
  }

  // The period always sits under the amount, so the three cards' rows line up whatever their prices.
  .card__figure {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-stat);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    color: var(--fg1);
  }

  .card__per {
    display: block;
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    color: var(--fg3);
  }

  .card__group {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .card__list {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
    font-size: var(--t-body-sm);
    color: var(--fg2);
  }

  .card__note {
    margin-top: var(--s-3);
    font-size: var(--t-small);
  }

  .card__foot {
    margin-top: auto;
    padding-top: var(--s-6);
  }
</style>
