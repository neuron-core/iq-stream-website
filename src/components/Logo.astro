---
import LogoMark from '../assets/logo.svg';
import LogoMarkWhite from '../assets/logo-white.svg';
import { SITE_NAME } from '../consts/site';

interface Props {
  /** The white version, for dark backgrounds. */
  white?: boolean;
}

const { white = false } = Astro.props;
const Mark = white ? LogoMarkWhite : LogoMark;
---

<span class="logo">
  <Mark class="logo__mark" aria-hidden="true" />
  <span class="logo__word">{SITE_NAME}</span>
</span>

<style lang="scss">
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-brand);
    font-size: var(--t-h4);
    font-weight: var(--weight-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-heading);
    color: var(--fg1);
  }

  .logo__mark {
    height: 0.8em;
    width: auto;
  }
</style>
