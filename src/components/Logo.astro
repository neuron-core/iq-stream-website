---
import LogoMark from '../assets/logo.svg';
import { SITE_NAME } from '../consts/site';
---

<span class="logo">
  <LogoMark class="logo__mark" aria-hidden="true" />
  <span class="logo__word">{SITE_NAME}</span>
</span>

<style lang="scss">
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-brand);
    font-size: var(--t-h4);
    font-weight: var(--weight-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-heading);
    color: var(--fg1);
  }

  .logo__mark {
    height: 0.8em;
    width: auto;

    // The file carries the light-theme colours; here the ramp follows the tone instead,
    // running from the background towards the text colour, then the accent.
    // The rects come from the SVG file, so they sit outside this component's scope.
    :global(rect:nth-child(1)) { fill: var(--logo-1); }
    :global(rect:nth-child(2)) { fill: var(--logo-2); }
    :global(rect:nth-child(3)) { fill: var(--logo-3); }
    :global(rect:nth-child(4)) { fill: var(--logo-4); }
    :global(rect:nth-child(5)) { fill: var(--accent); }
  }
</style>
