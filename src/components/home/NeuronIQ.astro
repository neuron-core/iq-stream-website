---
import { NEURON_IQ, SITE_NAME } from '../../consts/site';
import Button from '../Button.astro';
import Panel from '../Panel.astro';
---

<Panel as="article">
  <div class="neuron">
    <div>
      <p class="eyebrow">Neuron IQ</p>
      <h3>Part of the <em>Neuron IQ</em> professional services.</h3>
      <p>
        Neuron IQ is priority support and a production platform for Neuron AI, the open source PHP framework for building
        AI agents. Teams taking agents into production get priority bug fixes, a direct line to the team that created
        Neuron, custom extensions and specialist consulting. {SITE_NAME} is part of it.
      </p>
    </div>
    <Button href={NEURON_IQ.href} variant="dark">{NEURON_IQ.label}</Button>
  </div>
</Panel>

<style lang="scss">
  // Text on the left, the button beside it from md up; stacked on phones.
  .neuron {
    display: grid;
    gap: var(--s-6);

    @include up(md) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--s-8);
    }
  }
</style>
