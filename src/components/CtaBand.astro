---
// A slim band between two sections, halfway down a page: one line, and the sign-up button.
import Button from './Button.astro';
import { GET_STARTED } from '../consts/site';
---

<aside class="band" data-tone="ink" aria-label={GET_STARTED.short}>
  <div class="container band__inner">
    <p class="band__line"><slot /></p>
    <Button href={GET_STARTED.href} variant="primary">{GET_STARTED.label}</Button>
  </div>
</aside>

<style lang="scss">
  .band {
    padding-block: var(--s-7);
  }

  .band__inner {
    display: grid;
    gap: var(--s-5) var(--s-7);

    @include up(md) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  .band__line {
    max-width: var(--measure-title);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--fg1);
    text-wrap: balance;

    // Same emphasis as the headings: Sora has no italic.
    :global(em) {
      font-weight: var(--weight-semibold);
    }
  }
</style>
