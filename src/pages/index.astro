---
import Block from '../components/Block.astro';
import Button from '../components/Button.astro';
import Claim from '../components/Claim.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FeatureColumns from '../components/FeatureColumns.astro';
import Grid from '../components/Grid.astro';
import PageHero from '../components/PageHero.astro';
import Row from '../components/Row.astro';
import Rows from '../components/Rows.astro';
import RuledGrid from '../components/RuledGrid.astro';
import Section from '../components/Section.astro';
import Stat from '../components/Stat.astro';
import DataPath from '../components/home/DataPath.astro';
import Libraries from '../components/home/Libraries.astro';
import NeuronIQ from '../components/home/NeuronIQ.astro';
import ReplayChart from '../components/home/ReplayChart.astro';
import CtaBand from '../components/CtaBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPETITORS,
  IQ,
  LOST_ON_RECONNECT,
  LOST_WITHOUT_REPLAY,
  MERCURE_HISTORY,
  MERCURE_HISTORY_PEAK,
  ONE_VCPU,
  REVERB_SHORT,
  RUN,
  THROUGHPUT_MULTIPLE,
  TWO_VCPU_MULTIPLE,
} from '../consts/benchmark';
import { GET_STARTED, PAGES, SITE_NAME } from '../consts/site';
import { formatNumber } from '../utils/format';

const oneVcpu = formatNumber(IQ.oneVcpu.eventsPerSecond);
// The benchmark's lightest load on one vCPU.
const { runs: lightLoad, results: atLightLoad } = ONE_VCPU[0];

const steps = [
  {
    title: 'Publish',
    text: `Your backend sends each chunk of model output to ${SITE_NAME} as it arrives, over a plain HTTP request, from any language.`,
  },
  {
    title: 'Fan out',
    text: `${SITE_NAME} fans it out to the browsers watching that answer over Server-Sent Events, the standard the browser already knows. The built-in <code>EventSource</code> is the whole client.`,
  },
  {
    title: 'Hold',
    text: `While the answer is being generated, ${SITE_NAME} keeps it in memory, so any browser that reconnects resumes exactly where it left off, and the user never notices.`,
  },
  {
    title: 'Let go',
    text: `When the answer ends, ${SITE_NAME} lets it go. Your backend already has the result. ${SITE_NAME} carries it only while it is being written.`,
  },
];

const savings = [
  {
    eyebrow: 'Experience',
    title: 'The experience users expect, out of the box.',
    text: 'Replay is built into the server: an answer that loses its connection simply continues where it stopped, without you building anything.',
  },
  {
    eyebrow: 'Code',
    title: 'No reconnection logic to build.',
    text: 'No buffering tokens in Redis, no “resume from offset” endpoints, no client-side state machines.',
  },
  {
    eyebrow: 'Support',
    title: 'Fewer complaints about a UI that keeps breaking.',
    text: 'Users can switch between chats and see their agents pick up exactly where they left off.'
  },
];

const contract = [
  {
    title: 'Every event, in order, exactly once.',
    text: 'All browsers watching an answer see the same events in the same order.',
  },
  {
    title: 'A clear ending.',
    text: 'Each browser receives a final signal: the answer finished, or it failed and why.',
  },
  {
    title: 'An honest “it’s over”.',
    text: 'A browser that comes back after the answer ended is told so right away, and loads the final result from your backend, instead of hanging or showing half an answer.',
  },
  {
    title: 'Slow devices never slow down others.',
    text: 'Each browser is served at its own pace. A slow phone never holds back the other viewers, and is never dropped for being slow.',
  },
  {
    title: 'Connections stay alive while the model thinks.',
    text: 'Regular heartbeats keep proxies and load balancers from closing a stream while an agent waits on a tool.',
  },
];

---

<BaseLayout
  title="Stream LLM tokens"
  description={`${SITE_NAME} is a streaming server built for one job: carrying the tokens of an LLM answer from your application backend to your users’ browsers, in real time.`}
>
  <PageHero
    eyebrow={`${SITE_NAME} · one job, done properly`}
    lead={`${SITE_NAME} is a streaming server built for one job: carrying the tokens of an LLM answer from your application backend to your users’ browsers, in real time.`}
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'See the benchmark →', href: PAGES.performance },
    ]}
    metrics={[
      { value: '1', unit: 'vCPU', label: 'One process, one core' },
      { value: oneVcpu, unit: '/s', label: 'Events per second' },
      { value: String(LOST_ON_RECONNECT), label: 'Events lost on reconnect' },
    ]}
  >
    <Fragment slot="title">Stream LLM tokens. <br><em>Nothing else.</em> <br>Better than anything else.</Fragment>
    <p>
      It delivers {THROUGHPUT_MULTIPLE.min} to {THROUGHPUT_MULTIPLE.max} times as many events per CPU as general-purpose real-time servers. When a
      user’s connection drops, {SITE_NAME} picks up exactly where it stopped, and the user never notices.
    </p>
  </PageHero>

  <Section
    id="what"
    eyebrow={`What ${SITE_NAME} is`}
    lead={`${SITE_NAME} is a streaming server specialized in a single task: relaying LLM output from application backends to browsers.`}
  >
    <Fragment slot="title">Doing one thing is what makes it <em>fast</em>.</Fragment>
    <RuledGrid slot="aside" items={steps} variant="display" numbered />
    <DataPath />
  </Section>

  <Section id="replay" tone="ink" eyebrow="Stream replay">
    <Fragment slot="title">The connection will drop. The answer <em>won’t</em>.</Fragment>
    <Fragment slot="aside">
      <p>
        Mobile users change networks. Laptops sleep. Corporate proxies cut idle connections. On a ten-second answer,
        some of your users will lose their connection mid-stream every day.
      </p>
      <p>
        With {SITE_NAME}, the browser simply reconnects, and <strong>{SITE_NAME} replays exactly the tokens it missed, then continues
        live</strong>. No gaps, no repeats, nothing for your frontend or backend to rebuild. The browser’s
        standard <code>EventSource</code> does it on its own: it reconnects and tells {SITE_NAME} the last event it received.
      </p>
    </Fragment>
    <ReplayChart />
    <Grid min="lg" align="end">
      <Stat size="lg" value={String(LOST_ON_RECONNECT)} label="Events lost on reconnect" />
      <p>
        In the benchmark, {RUN.disconnects} lost its connection mid-answer. At {formatNumber(IQ.twoVcpus.runs)} concurrent
        runs, {IQ.twoVcpus.reconnected} browsers reconnected, and every one of them got back every event it had
        missed: <strong>{LOST_ON_RECONNECT} events lost</strong>.
      </p>
    </Grid>
  </Section>

  <Section id="why" eyebrow="Why it matters for AI products">
    <Fragment slot="title">Built-in streaming <em>replay</em>.</Fragment>
    <FeatureColumns items={savings} />
    <Block lead={`Replay is only half of it. ${SITE_NAME} also guarantees that every browser learns how the answer ended, even one that reconnects too late.`}>
      <Fragment slot="title">A complete contract for <em>every answer</em>.</Fragment>
      <RuledGrid items={contract} min="sm" variant="display" />
    </Block>
  </Section>

  <CtaBand>Ship answers that survive <em>every dropped connection</em>.</CtaBand>

  <Section id="different" tone="soft" eyebrow="Specialized, not general purpose">
    <Fragment slot="title">Why general-purpose servers can’t do this at {`${SITE_NAME} `}<em>speed</em>.</Fragment>
    <Block eyebrow="When a browser reconnects mid-answer">
      <Rows>
        <Row title={SITE_NAME}>
          <p>
            Resumes from the exact event it missed, from memory, at full speed: {oneVcpu} events/s on one vCPU.
          </p>
        </Row>
        <Row title={`${COMPETITORS.join(', ')} (default)`}>
          <p>
            Keep nothing. The browser loses everything sent while it was away: about {LOST_WITHOUT_REPLAY} events
            of a {RUN.events}-event run in the benchmark, the middle of the answer.
          </p>
        </Row>
        <Row title={MERCURE_HISTORY}>
          <p>
            Can resume, but writes every event to a database file before relaying it. It never
            passed <strong>{MERCURE_HISTORY_PEAK} events per second</strong>, and at just {lightLoad} concurrent runs
            its p99 latency was <strong>{Math.floor(atLightLoad.mercureHistory.p99Ms / 1000)} seconds</strong>.
          </p>
        </Row>
      </Rows>
    </Block>
    <Claim>
      <Fragment slot="quote">General-purpose servers make you choose: speed without replay, or replay without speed.</Fragment>
      <Block lead={`${SITE_NAME} keeps every running answer in memory, for as long as it is being written and no longer, so replay costs nothing on the hot path: no disk, no database, no broker. That is how it resumes a browser within milliseconds of reconnecting while relaying tens of thousands of events per second.`}>
        <Button href={PAGES.performance}>Specialization vs general purpose →</Button>
      </Block>
    </Claim>
  </Section>

  <Section
    tone="ink"
    lead={`${SITE_NAME} runs as a single process on one CPU, or as a cluster that uses every CPU of the machine, and scales with them.`}
  >
    <Fragment slot="title">Performance and <em>scalability</em>.</Fragment>
    <Block>
      <Grid min="sm">
        <Stat value={oneVcpu} unit="/s" label="Events relayed on one vCPU" accent />
        <Stat value={String(IQ.twoVcpus.cpuPerEventUs)} unit="µs" label="CPU per event, TLS included" />
        <Stat value={formatNumber(IQ.twoVcpus.eventsPerSecond)} unit="/s" label="Events relayed on two vCPUs" />
        <Stat value={`${TWO_VCPU_MULTIPLE.reverb}×`} label={`What ${REVERB_SHORT} moved on the same two vCPUs`} />
      </Grid>
      <Button href={PAGES.performance}>See the full benchmark →</Button>
    </Block>
  </Section>

  <Section id="endpoint" eyebrow="One endpoint for any language" align="center">
    <Fragment slot="title">One endpoint. <em>Any language.</em></Fragment>
    <CodeBlock
      slot="aside"
      labels={['in the browser']}
      description="Browser code: a standard EventSource opened on the watch URL, rendering each message as it arrives."
    >
      <div class="tok-c">// standard Server-Sent Events. No SDK.</div>
      <div><span class="tok-k">const </span>stream<span class="tok-p"> = </span><span class="tok-k">new </span>EventSource<span class="tok-p">(</span>watchUrl<span class="tok-p">);</span></div>
      <div>stream<span class="tok-p">.</span>onmessage<span class="tok-p"> = (</span>event<span class="tok-p">) =&gt; </span>render<span class="tok-p">(</span>event<span class="tok-p">.</span>data<span class="tok-p">);</span></div>
    </CodeBlock>
    <Block
      eyebrow="Official libraries"
      lead="For PHP, JavaScript and Python, an official library signs the tokens, holds the connection while the model writes and closes each answer for you. Its adapters publish the runs of the most used agent frameworks in a few lines."
    >
      <Fragment slot="title">Ready for the <em>framework you use</em>.</Fragment>
      <Libraries />
    </Block>
  </Section>

  <PageHero
    variant="cta"
    lead={`${SITE_NAME} is the streaming layer AI products should have had from the start: built for tokens, fast on a single CPU, resilient to every dropped connection, and ready to host one app or thousands.`}
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'See the benchmark →', href: PAGES.performance },
      { label: 'For cloud providers →', href: PAGES.cloud },
    ]}
  >
    <Fragment slot="title">Deliver the agentic experience <em>your users expect</em>.</Fragment>
  </PageHero>
</BaseLayout>
