---
import Block from '../components/Block.astro';
import Chips from '../components/Chips.astro';
import ClusterMultiples from '../components/ClusterMultiples.astro';
import FeatureColumns from '../components/FeatureColumns.astro';
import Grid from '../components/Grid.astro';
import PageHero from '../components/PageHero.astro';
import Panel from '../components/Panel.astro';
import Section from '../components/Section.astro';
import Stat from '../components/Stat.astro';
import AgentRun from '../components/performance/AgentRun.astro';
import CapacityTable from '../components/performance/CapacityTable.astro';
import LevelTable from '../components/performance/LevelTable.astro';
import CtaBand from '../components/CtaBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPETITORS,
  DELIVERY_THRESHOLD,
  HOLD,
  IQ,
  LOST_ON_RECONNECT,
  LOST_WITHOUT_REPLAY,
  MERCURE,
  MERCURE_HISTORY,
  MERCURE_HISTORY_PEAK,
  ONE_VCPU,
  REVERB,
  REVERB_SHORT,
  RUN,
  SCALED_OUT_SERVERS,
  SERVERS,
  SETUP,
  SOKETI,
  SUMMARY,
  THROUGHPUT_MULTIPLE,
  TWO_VCPUS,
} from '../consts/benchmark';
import { ANSWERS_IN_MEMORY, LEFT_OUT } from '../consts/product';
import { GET_STARTED, PAGES, SITE_NAME } from '../consts/site';
import { formatNumber, listAnd } from '../utils/format';

const oneVcpu = formatNumber(IQ.oneVcpu.eventsPerSecond);
const twoVcpus = formatNumber(IQ.twoVcpus.eventsPerSecond);
const summary = (key: string) => SUMMARY.find((server) => server.key === key)!;
const cpuRange = (key: string) => `${summary(key).cpuPerEventUs.min} to ${summary(key).cpuPerEventUs.max}`;
const levels = (all: { runs: number }[]) => listAnd(all.map(({ runs }) => formatNumber(runs)));
const mercure = summary('mercure');
// The level after the one Mercure held on one vCPU, where it fell behind.
const mercureBehind = ONE_VCPU.find(({ runs }) => runs > mercure.oneVcpu.runs)!;
const seconds = (ms: number) => `${(ms / 1000).toFixed(1)} seconds`;

const symptoms = [
  {
    eyebrow: '01 · CPU',
    title: 'It runs out of CPU long before you expect.',
    text: 'Every token pays the full price of a message built for a different job.',
  },
  {
    eyebrow: '02 · Latency',
    title: 'Latency piles up.',
    text: 'Once the server falls behind, tokens arrive in bursts, seconds late, and the “typing” effect your users expect falls apart.',
  },
  {
    eyebrow: '03 · Reconnects',
    title: 'Dropped connections lose tokens.',
    text: 'The browser reconnects and the middle of the answer is gone. The user sees a broken answer.',
  },
];
---

<BaseLayout
  title="Performance and scalability"
  description={`${SITE_NAME} benchmarked against ${listAnd(COMPETITORS)} on the exact traffic an AI product generates: throughput, latency, scaling and replay.`}
>
  <PageHero
    eyebrow="Performance and scalability"
    lead={`${SITE_NAME} was benchmarked against three of the best-known real-time servers on the exact traffic an AI product generates.`}
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'How we measured →', href: '#benchmark' },
    ]}
    metrics={[
      { value: oneVcpu, unit: '/s', label: 'Events on one vCPU' },
      { value: twoVcpus, unit: '/s', label: 'Events on two vCPUs' },
      { value: String(IQ.twoVcpus.cpuPerEventUs), unit: 'µs', label: 'CPU per event, TLS included' },
      { value: String(LOST_ON_RECONNECT), label: 'Events lost on reconnect' },
    ]}
  >
    <Fragment slot="title">
      <em>{THROUGHPUT_MULTIPLE.max}×</em> the throughput of general-purpose servers.
    </Fragment>
  </PageHero>

  <Section id="one-cpu" eyebrow="The test">
    <Fragment slot="title">The exact traffic an AI product <em>generates</em>.</Fragment>
    <Fragment slot="aside">
      <p>
        Simulated agent runs, each made of {RUN.events} {RUN.protocol} events over about {RUN.seconds} seconds.
        Each run has a streamed text answer, a tool call with
        streamed arguments, a {RUN.toolPauseSeconds}-second pause while the tool runs, an {RUN.toolResultKb} KB tool
        result, and a second answer, with runs starting and ending all the time and {RUN.disconnects} losing its connection
        mid-answer.
      </p>
      <p>
        <strong>Each server ran alone on a cloud VM of the same type, in its fastest configuration, answering HTTPS as
        it does in production.</strong>
      </p>
    </Fragment>
    <AgentRun />
    <CapacityTable
      title="What each server holds"
      caption={`${SETUP.cloud} ${SETUP.processor}, with HTTPS`}
      note={`A server holds a level when at least ${HOLD.deliveredPct}% of the events arrive, with a p99 latency under ${HOLD.p99Ms} ms. ${SITE_NAME}’s levels come from raising the load until it fell behind. The others ran at ${levels(ONE_VCPU)} concurrent runs per vCPU, so their limit lies between the level they held and the next. Most events/s is ${SITE_NAME}’s at the level it holds, every event on time; the others reached theirs only while overloaded, with events arriving seconds late.`}
    />
    <LevelTable
      title="One vCPU, level by level"
      caption={`${SITE_NAME} vs ${COMPETITORS.join(', ')}, on a ${SETUP.oneVcpu.instance}`}
      servers={SERVERS}
      levels={ONE_VCPU}
      iq={IQ.oneVcpu}
      note={`${SITE_NAME} was not run at the benchmark’s levels: its row is the most it held, from runs of its own on an ${SETUP.iqOneVcpuInstance}, with the same core and more memory. Those runs published its events per second and that it held the level, at least ${HOLD.deliveredPct}% delivered with a p99 latency under ${HOLD.p99Ms} ms, not its CPU or memory. Delivered is the share of the offered events that reached the browsers. CPU includes nginx’s, as a share of one vCPU. Missed is the share of the events that reconnecting browsers never received. A dash (–) marks a figure that was not published, or Missed for a server that delivered under ${DELIVERY_THRESHOLD}%, whose backlog blurs it.`}
    />
  </Section>

  <Section tone="ink">
    <Fragment slot="title">What the numbers <em>say</em>.</Fragment>
    <Grid min="sm">
      <Stat value={formatNumber(IQ.oneVcpu.runs)} unit="runs" label="Held on one vCPU" accent>
        About {oneVcpu} events per second, every one on time. The fastest general-purpose server, {MERCURE},
        held {mercure.oneVcpu.runs}, and at {mercureBehind.runs} its p99 latency was
        already {seconds(mercureBehind.results.mercure.p99Ms)}.
      </Stat>
      <Stat value={String(IQ.twoVcpus.cpuPerEventUs)} unit="µs" label="CPU per event, TLS and HTTP/2 included">
        On two vCPUs, at its limit. {MERCURE} took {cpuRange('mercure')} µs, {SOKETI} with nginx {cpuRange('soketi')},
        and {REVERB_SHORT} with nginx {cpuRange('reverb')}.
      </Stat>
      <Stat value={String(LOST_ON_RECONNECT)} label="Events missed on reconnect">
        None of the {IQ.twoVcpus.reconnected} browsers that reconnected at {formatNumber(IQ.twoVcpus.runs)} runs
        missed an event. Each one that reconnected to {MERCURE} or {SOKETI}, which keep nothing, lost
        about {LOST_WITHOUT_REPLAY} of its run’s {RUN.events}.
      </Stat>
      <Stat value={String(MERCURE_HISTORY_PEAK)} unit="/s" label={`${MERCURE_HISTORY}, at most`}>
        The only other server that resumes browsers commits every event to disk before relaying it. It never
        passed {MERCURE_HISTORY_PEAK} events per second, on either machine.
      </Stat>
    </Grid>
  </Section>

  <Section id="cluster" eyebrow="Scalability">
    <Fragment slot="title">From one CPU to <em>every CPU</em> of the machine.</Fragment>
    <p slot="aside">
      {SITE_NAME} runs as a single process on one CPU, or as a cluster that uses every CPU of the machine: one worker per CPU,
      with a lightweight router in front. Each answer lives on one worker, so its tokens go straight from your backend
      to your users’ browsers, never crossing processes and never passing through a broker.
    </p>
    <LevelTable
      title="Two vCPUs, level by level"
      caption={`${SITE_NAME} vs ${COMPETITORS.join(', ')}, on a ${SETUP.twoVcpus.instance}`}
      servers={SCALED_OUT_SERVERS}
      levels={TWO_VCPUS}
      iq={IQ.twoVcpus}
      note={`${SITE_NAME}’s cluster was not run at the benchmark’s levels either: its row is the most it held, from runs of its own, which published its events per second, its CPU per event and its missed events, not its CPU share or memory. None of the ${IQ.twoVcpus.reconnected} browsers that reconnected missed an event. ${MERCURE} ran its one process on both vCPUs; ${listAnd([REVERB_SHORT, SOKETI])} ran a process per vCPU with Redis between them, and Redis’s CPU and memory count as theirs.`}
    />
    <Grid min="lg">
      <div>
        <h3>{SITE_NAME} scales with its CPUs.</h3>
        <p>
          Its cluster held {formatNumber(IQ.twoVcpus.runs)} concurrent runs on two vCPUs, {twoVcpus} events per second
          at {IQ.twoVcpus.cpuPerEventUs} µs each, and {formatNumber(IQ.fourVcpus.runs)} on four, with every worker
          equally busy.
        </p>
      </div>
      <div>
        <h3>General-purpose servers fall behind far sooner.</h3>
        <p>
          {MERCURE}’s one process held {mercure.twoVcpus.runs} concurrent runs on two vCPUs, and peaked
          at {formatNumber(mercure.twoVcpus.eventsPerSecond)} events per second. {listAnd([SOKETI, REVERB_SHORT])},
          scaled out the way their documentation describes, peaked
          at {formatNumber(summary('soketi').twoVcpus.eventsPerSecond)} and {formatNumber(summary('reverb').twoVcpus.eventsPerSecond)},
          and each event cost them more CPU than on one process, because every event crosses Redis to reach the right one.
        </p>
      </div>
    </Grid>
    <ClusterMultiples eyebrow={`On the same two vCPUs, ${SITE_NAME} moved`} />
    <Panel>
      <Grid min="lg">
        <div>
          <p class="eyebrow">Memory</p>
          <h3>Light on <em>memory</em>.</h3>
          <p>
            {SITE_NAME} keeps every running agent run in full, so any browser can resume it, and still
            held {formatNumber(IQ.fourVcpus.runs)} concurrent runs in under {IQ.fourVcpus.memoryGib} GiB.
            A {ANSWERS_IN_MEMORY.containerGb} GB container holds about {formatNumber(ANSWERS_IN_MEMORY.answers)} complete {formatNumber(ANSWERS_IN_MEMORY.tokensPerAnswer)}-token
            answers in flight at once. {SITE_NAME} sizes itself
            from its container’s memory limit and refuses new work before it runs out, so a traffic spike never crashes
            the process and the answers already running.
          </p>
        </div>
        <Grid min="sm">
          <Stat
            value={`< ${IQ.fourVcpus.memoryGib}`}
            unit="GiB"
            label={`At ${formatNumber(IQ.fourVcpus.runs)} concurrent runs, kept in full`}
          />
          <Stat
            value={formatNumber(ANSWERS_IN_MEMORY.answers)}
            label={`${formatNumber(ANSWERS_IN_MEMORY.tokensPerAnswer)}-token answers in a ${ANSWERS_IN_MEMORY.containerGb} GB container`}
          />
        </Grid>
      </Grid>
    </Panel>
  </Section>

  <CtaBand>Every event on time, <em>long after the others fall behind</em>.</CtaBand>

  <Section id="specialization" tone="soft" eyebrow="Specialization vs general purpose" align="center">
    <Fragment slot="title">General-purpose servers were built for notifications, not for <em>LLM answers</em>.</Fragment>
    <Fragment slot="aside">
      <p>
        Chat assistants, copilots, agents and AI search all send their answers word by word. But WebSocket hubs, pub/sub
        brokers and notification servers were designed to deliver a chat message or a notification now and then.
      </p>
      <p>
        An LLM answer is not like that. It is <em>hundreds of small events, a few dozen milliseconds apart, for ten seconds
        or more</em>, with pauses while a tool runs and the occasional large payload, for every user at once.
      </p>
    </Fragment>
    <Block lead="Put that traffic through a general-purpose server and three things happen:">
      <FeatureColumns items={symptoms} />
    </Block>
    <Grid min="lg">
      <Block lead={`${SITE_NAME} was built to remove all three. It keeps every running answer in memory, for as long as it is being written and no longer, so replay costs nothing on the hot path. Just the shortest possible path from your model to your user’s screen.`}>
        <Fragment slot="title">Doing one thing is what makes it <em>fast</em>.</Fragment>
      </Block>
      <Block eyebrow="Nothing else">
        <Chips items={LEFT_OUT} strike />
      </Block>
    </Grid>
  </Section>

  <Section id="benchmark" eyebrow="Benchmark">
    <Fragment slot="title">How we <em>measured</em>.</Fragment>
    <Fragment slot="aside">
      <p>
        The figures on this page come from {SITE_NAME}’s reproducible benchmark suite. It streams
        simulated {RUN.protocol} agent runs through each server and measures the events delivered, the CPU and memory used, the
        latency each event saw from the moment the model produced it, and the events browsers missed when their
        connection dropped.
      </p>
      <p>
        It ran on {SETUP.cloud} ({SETUP.region}), each server alone on a {SETUP.processor} VM of the types {SITE_NAME}’s
        cloud runs on: a <code>{SETUP.oneVcpu.instance}</code> with one vCPU and {SETUP.oneVcpu.memoryGib} GiB, and
        a <code>{SETUP.twoVcpus.instance}</code> with two vCPUs and {SETUP.twoVcpus.memoryGib} GiB, every server with the
        same memory limit. The load generator ran on a <code>{SETUP.loadGenerator.instance}</code> in the same zone, and
        never used half of its CPU. {SITE_NAME}’s one-vCPU figure comes from
        an <code>{SETUP.iqOneVcpuInstance}</code>, with the same core and more memory.
      </p>
      <p>
        Every server answered HTTPS, as it does in production: {SITE_NAME}, with HTTP/2 for browsers and 50 ms batching,
        and {MERCURE} on their own; {listAnd([REVERB, SOKETI])} behind nginx, as their documentation deploys them, with
        nginx’s CPU and memory counted as theirs. Each competitor ran in its fastest documented setup: {MERCURE} with its
        in-memory transport, and again with Bolt, its default transport, which keeps history; {REVERB} with its
        recommended event loop and production settings; {SOKETI} with its official
        image; {listAnd([REVERB_SHORT, SOKETI])} scaled out with Redis on two vCPUs, as their documentation describes. Every server checked that each browser
        was allowed to read the stream it asked for.
      </p>
    </Fragment>
  </Section>

  <PageHero
    variant="cta"
    lead={`Create a free account and stream your app’s LLM answers through ${SITE_NAME}.`}
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'For cloud providers →', href: PAGES.cloud },
    ]}
  >
    <Fragment slot="title">Put this performance in front of <em>your users</em>.</Fragment>
  </PageHero>
</BaseLayout>
