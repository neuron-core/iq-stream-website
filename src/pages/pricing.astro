---
import PageHero from '../components/PageHero.astro';
import Row from '../components/Row.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import Comparison from '../components/pricing/Comparison.astro';
import PricingCards from '../components/pricing/PricingCards.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FREE, MONTHS_FREE, OVERAGE_CENTS, PRIVATE_SIZES, PRO, SCALE, centsAMonth } from '../consts/pricing';
import { CONTACT, GET_STARTED, SITE_NAME } from '../consts/site';
import { formatCents, formatNumber, listOr, plural } from '../utils/format';

const largest = PRIVATE_SIZES[PRIVATE_SIZES.length - 1];
const cheapestSize = formatCents(Math.min(...PRIVATE_SIZES.map((size) => centsAMonth(size, 'monthly'))));
const overage = formatCents(OVERAGE_CENTS);
const free = `${plural(FREE.apps, 'app')} and ${formatNumber(FREE.streams)} concurrent streams`;
---

<BaseLayout
  title="Pricing"
  description={`${SITE_NAME} pricing: shared plans from free, private regions from ${cheapestSize} a month, priced by concurrent streams with no cap on messages.`}
>
  <PageHero
    eyebrow="Pricing"
    lead="Start on a shared region, for free. Move to a server of your own when you outgrow it. No plan counts messages, so every token is included."
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'Compare with Pusher and Mercure →', href: '#compare' },
    ]}
    metrics={[
      { value: formatCents(centsAMonth(FREE, 'monthly')), label: `${FREE.name}: ${plural(FREE.apps, 'app')}, ${formatNumber(FREE.streams)} concurrent streams` },
      { value: formatNumber(largest.streams), label: `Concurrent streams on a ${largest.name} private region` },
      { value: '0', label: 'Caps on messages or publishes' },
    ]}
  >
    <Fragment slot="title">Shared or private. <em>Never per message.</em></Fragment>
  </PageHero>

  <Comparison />

  <PricingCards />

  <Section id="faq" eyebrow="FAQ">
    <Fragment slot="title">Questions before you <em>pay</em>.</Fragment>
    <Rows>
      <Row title="What happens past a private region’s egress allowance?">
        <p>
          Each GB past it is {overage}, counted per region and calendar month and billed monthly, on annual terms too:
          the allowance resets every month. Your team’s Owner and Admins get an email at 80% and at 100% of it. Nothing
          stops: streams keep flowing.
        </p>
      </Row>
      <Row title="Do prices include VAT?">
        <p>
          No. Prices are in euros and exclude VAT, which checkout adds where it’s due. Businesses in the EU outside Italy
          with a valid VAT ID pay none, under the reverse charge.
        </p>
      </Row>
      <Row title="How do annual terms work?">
        <p>
          Annual is {MONTHS_FREE} months free: you pay {12 - MONTHS_FREE} months up front for 12. On a plan, upgrades take
          effect at once, while downgrades and cancelling wait for the end of the year. An annual private region is a
          commitment: downsizing or deleting it before renewal gives no credit.
        </p>
      </Row>
      <Row title={`Who can use ${FREE.name}?`}>
        <p>
          Only a personal team, the one every account starts with. You can invite members to it, so a small group can
          try {SITE_NAME} together. Any other team needs {listOr([PRO.name, SCALE.name])} for apps in shared regions.
          Private regions are open to every team, {FREE.name} included, and are paid on their own.
        </p>
      </Row>
    </Rows>
  </Section>

  <PageHero
    variant="cta"
    lead={`${free} on your personal team, then ${PRO.name}, ${SCALE.name} or a private region when you need more.`}
    actions={[{ ...GET_STARTED, variant: 'primary' }, CONTACT]}
  >
    <Fragment slot="title">Start on a shared region, <em>free</em>.</Fragment>
  </PageHero>
</BaseLayout>
