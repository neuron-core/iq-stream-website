---
import PageHero from '../components/PageHero.astro';
import Row from '../components/Row.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import NoMessageCap from '../components/pricing/NoMessageCap.astro';
import PricingCards from '../components/pricing/PricingCards.astro';
import UsageBilling from '../components/pricing/UsageBilling.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, EXTRA_GB_CENTS, EXTRA_STREAM_CENTS, FREE_APP, HOBBY, PLANS } from '../consts/pricing';
import { CONTACT, GET_STARTED, SITE_NAME } from '../consts/site';
import { formatCents, formatGigabytes, formatNumber, formatUnitPrice, listOr } from '../utils/format';

const extraStream = formatUnitPrice(EXTRA_STREAM_CENTS);
const extraGb = formatUnitPrice(EXTRA_GB_CENTS);
const planNames = listOr(PLANS.map(({ name }) => name));
const freeApp = `${formatNumber(FREE_APP.maxStreams)} concurrent streams and ${formatGigabytes(FREE_APP.egressGb)} of egress a month`;
---

<BaseLayout
  title="Pricing"
  description={`${SITE_NAME} pricing: a plan per app from ${formatCents(HOBBY.cents)} a month, priced by concurrent streams and egress, with no cap on messages.`}
>
  <PageHero
    eyebrow="Pricing"
    lead={`We never cap the number of messages. A plan prepays concurrent streams and egress for one app. Above them you pay ${extraStream} for each extra concurrent stream at the month’s peak, and ${extraGb} per GB.`}
    actions={[
      { ...GET_STARTED, variant: 'primary' },
      { label: 'See the plans →', href: '#plans' },
    ]}
    metrics={[
      { value: '0', label: 'Caps on messages or publishes' },
      {
        value: formatCents(HOBBY.cents),
        label: `A month for an app on ${HOBBY.name}, ${formatNumber(HOBBY.prepaidStreams)} concurrent streams prepaid`,
      },
      { value: extraStream, label: 'Per extra concurrent stream, at the month’s peak' },
    ]}
  >
    <Fragment slot="title">Pay for concurrency. <em>Never per message.</em></Fragment>
  </PageHero>

  <NoMessageCap />

  <PricingCards />

  <UsageBilling />

  <Section id="faq" eyebrow="FAQ">
    <Fragment slot="title">Questions before you <em>pay</em>.</Fragment>
    <Rows>
      <Row title="Is a plan per app or per team?">
        <p>
          Per app. Each app has its own plan, its own invoice and its own month, which starts on the day you bought its
          plan. A team can run one app on {HOBBY.name} and another on {BUSINESS.name}.
        </p>
      </Row>
      <Row title="Who gets the free app?">
        <p>
          Every account starts with a personal team, and it holds one free app: {freeApp}, never billed. Past that egress
          it pauses until the 1st. Every other app, and every app of another team, runs on {planNames}.
        </p>
      </Row>
      <Row title="What happens at my plan’s maximum?">
        <p>
          New streams are refused until one ends, and the month’s peak never bills past the maximum. Your team’s Owner
          gets an email at 80% and at 100% of each prepaid quota, so you can move to a larger plan first.
        </p>
      </Row>
      <Row title="Can I change plans?">
        <p>
          Yes. An upgrade takes effect at once, and the month’s usage before and after it is measured against each plan’s
          prepaid streams and egress. A downgrade or a cancellation waits for the end of the month.
        </p>
      </Row>
      <Row title="What is a private link?">
        <p>
          Your VPC reaches the region over AWS PrivateLink, at the same URL, so your backend publishes without a NAT
          gateway or internet egress. AWS bills the endpoint on your account, as it does any PrivateLink endpoint. It comes
          with every paid plan.
        </p>
      </Row>
    </Rows>
  </Section>

  <PageHero
    variant="cta"
    lead={`${formatNumber(FREE_APP.maxStreams)} concurrent streams on your personal team, then ${planNames} for each app that needs more.`}
    actions={[{ ...GET_STARTED, variant: 'primary' }, CONTACT]}
  >
    <Fragment slot="title">Start with a <em>free</em> app.</Fragment>
  </PageHero>
</BaseLayout>
